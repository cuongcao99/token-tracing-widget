{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Tracing Widget",
  "version": "0.1.0",
  "identifier": "com.token-tracing-widget.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token Tracing Widget",
        "width": 440,
        "height": 300,
        "minWidth": 360,
        "minHeight": 176,
        "maxWidth": 720,
        "maxHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
