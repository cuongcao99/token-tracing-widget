{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Tracing Widget",
  "version": "0.1.0",
  "identifier": "com.token-tracing-widget.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token Tracing Widget",
        "width": 440,
        "height": 316,
        "minWidth": 360,
        "minHeight": 192,
        "maxWidth": 720,
        "maxHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1QkU2RDI3NEY4NUZENzgK\nUldSNC9ZVlBKMjIrMVVFSkRxZ3dPa0k3UnowNlJDK3RNMWlFZlR4TkJoOUZmMjg5R1pvQy9ZSkgK",
      "endpoints": [
        "https://github.com/cuongcao99/token-tracing-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
