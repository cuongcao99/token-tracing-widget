{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Live Path: File Change to Updated Widget",
    "subtitle": "Path-free notification, incremental tail, atomic commit, and publish gate",
    "output": "03-live-update-and-recovery.html",
    "animation": "none",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1080, 695],
    "views": [
      {
        "id": "notification",
        "label": "Notification path",
        "focus": ["files", "watcher", "runtime"],
        "note": "The watcher reports only the provider; discovery decides what is safe to read."
      },
      {
        "id": "incremental-tail",
        "label": "Incremental tail",
        "focus": ["runtime", "files", "store"],
        "note": "The checkpoint offset avoids rereading committed bytes, while partial writes remain pending."
      },
      {
        "id": "publish-gate",
        "label": "Publish gate",
        "focus": ["store", "runtime", "ui"],
        "note": "Only a successful commit/query publishes; failures schedule retry and preserve the prior summary."
      }
    ]
  },
  "participants": [
    { "id": "files", "type": "external", "label": "Session files", "sublabel": "root" },
    { "id": "watcher", "type": "backend", "label": "Watcher + scheduler", "sublabel": "200 ms / 30 s" },
    { "id": "runtime", "type": "backend", "label": "Rust collector", "sublabel": "re-discover" },
    { "id": "store", "type": "database", "label": "SQLite index", "sublabel": "checkpoint" },
    { "id": "ui", "type": "frontend", "label": "Widget webview", "sublabel": "listener" }
  ],
  "segments": [
    { "from": 152, "to": 284, "label": "Signals" },
    { "from": 302, "to": 520, "label": "Incremental read" },
    { "from": 538, "to": 626, "label": "Commit + publish" }
  ],
  "messages": [
    { "id": "native-notification", "from": "files", "to": "watcher", "y": 180, "label": "ReadDirectoryChangesW", "variant": "dashed", "note": "filename is not forwarded" },
    { "id": "changed-signal", "from": "watcher", "to": "runtime", "y": 220, "label": "Changed(provider)", "variant": "emphasis", "note": "debounced to 200 ms" },
    { "id": "reconciliation-signal", "from": "watcher", "to": "runtime", "y": 260, "label": "30 s reconciliation", "variant": "dashed", "note": "recovers missed notifications" },
    { "id": "rediscover", "from": "runtime", "to": "files", "y": 310, "label": "re-discover newest candidates", "variant": "emphasis", "note": "same safe-root rules" },
    { "id": "metadata-return", "from": "files", "to": "runtime", "y": 345, "label": "size + mtime + private path", "variant": "return" },
    { "id": "load-checkpoint", "from": "runtime", "to": "store", "y": 385, "label": "load checkpoint", "variant": "default", "note": "identity is opaque hash" },
    { "id": "checkpoint-return", "from": "store", "to": "runtime", "y": 420, "label": "offset + cumulative baselines", "variant": "return" },
    { "id": "tail-file", "from": "runtime", "to": "files", "y": 460, "label": "read suffix; partial line waits", "variant": "emphasis", "note": "seek(byte_offset)" },
    { "id": "delta-return", "from": "files", "to": "runtime", "y": 500, "label": "delta events + pending offset", "variant": "return", "note": "reset creates new segment" },
    { "id": "atomic-write", "from": "runtime", "to": "store", "y": 545, "label": "atomic write + summary query", "variant": "emphasis", "note": "write error ⇒ no publish" },
    { "id": "commit-result", "from": "store", "to": "runtime", "y": 580, "label": "commit/query result", "variant": "return", "note": "failure ⇒ stale + backoff" },
    { "id": "live-event", "from": "runtime", "to": "ui", "y": 610, "label": "post-commit usage summary", "variant": "emphasis", "note": "1, 2, 4, 8, 16, 30 s retry cap" }
  ],
  "activations": [
    { "participant": "watcher", "from": 176, "to": 268, "type": "backend" },
    { "participant": "runtime", "from": 306, "to": 588, "type": "backend" },
    { "participant": "store", "from": 381, "to": 584, "type": "database" },
    { "participant": "ui", "from": 606, "to": 618, "type": "frontend" }
  ]
}
