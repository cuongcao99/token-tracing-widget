{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Read → Normalize → Aggregate → Render",
    "subtitle": "The exact metadata transformations inside the Rust-owned path",
    "output": "04-read-normalize-aggregate.html",
    "animation": "none",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "viewBox": [1080, 695],
    "views": [
      {
        "id": "parse-path",
        "label": "Parse path",
        "focus": ["file", "reader", "parser"],
        "note": "The reader advances by bytes; the adapter turns only supported record shapes into observations."
      },
      {
        "id": "delta-path",
        "label": "Delta path",
        "focus": ["parser", "normalizer", "dedupe", "sqlite"],
        "note": "Incremental Claude values pass through; cumulative Codex snapshots become deltas."
      },
      {
        "id": "display-path",
        "label": "Display path",
        "focus": ["sqlite", "aggregate", "payload"],
        "note": "Rust computes day/session/state values before exposing a strict typed payload."
      }
    ]
  },
  "stages": [
    { "label": "Bounded source" },
    { "label": "Read + parse" },
    { "label": "Validate + dedupe" },
    { "label": "Durable index" },
    { "label": "Summary + UI" }
  ],
  "nodes": [
    { "id": "file", "type": "external", "label": "Session file", "sublabel": "mtime", "stage": 0, "row": 0, "tag": "path private" },
    { "id": "checkpoint", "type": "database", "label": "Checkpoint", "sublabel": "offset", "stage": 0, "row": 2, "tag": "restart-safe" },
    { "id": "reader", "type": "backend", "label": "Bounded reader", "sublabel": "seek", "stage": 1, "row": 0, "tag": "partial-line aware" },
    { "id": "parser", "type": "backend", "label": "Provider parser", "sublabel": "counter", "stage": 1, "row": 2, "tag": "unknown kinds ignored" },
    { "id": "normalizer", "type": "backend", "label": "Validate", "sublabel": "time", "stage": 2, "row": 1, "tag": "nonnegative counters" },
    { "id": "dedupe", "type": "security", "label": "Delta + dedupe", "sublabel": "SHA-256", "stage": 2, "row": 3, "tag": "no raw record" },
    { "id": "sqlite", "type": "database", "label": "SQLite batch", "sublabel": "events", "stage": 3, "row": 1, "tag": "INSERT OR IGNORE" },
    { "id": "aggregate", "type": "backend", "label": "Aggregate", "sublabel": "day", "stage": 4, "row": 0, "tag": "saturating sums" },
    { "id": "payload", "type": "frontend", "label": "Typed summary", "sublabel": "state", "stage": 4, "row": 2, "tag": "camelCase wire" }
  ],
  "flows": [
    { "id": "file-to-reader", "from": "file", "to": "reader", "label": "file bytes", "classification": "filesystem metadata", "variant": "emphasis", "route": "straight", "labelDx": -80, "labelDy": 60 },
    { "id": "checkpoint-to-reader", "from": "checkpoint", "to": "reader", "label": "offset", "classification": "checkpoint", "variant": "default", "route": "vertical-channel" },
    { "id": "reader-to-parser", "from": "reader", "to": "parser", "label": "JSON values", "classification": "record stream", "route": "straight", "labelDy": 24 },
    { "id": "parser-to-normalizer", "from": "parser", "to": "normalizer", "label": "observation", "classification": "provider-neutral", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "normalizer-to-dedupe", "from": "normalizer", "to": "dedupe", "label": "valid counters", "classification": "invariant gate", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "dedupe-to-sqlite", "from": "dedupe", "to": "sqlite", "label": "UsageEvent", "classification": "normalized metadata", "variant": "security", "route": "vertical-channel" },
    { "id": "sqlite-to-aggregate", "from": "sqlite", "to": "aggregate", "label": "history rows", "classification": "query", "variant": "emphasis", "route": "vertical-channel" },
    { "id": "aggregate-to-payload", "from": "aggregate", "to": "payload", "label": "UsageSummary", "classification": "typed safe payload", "variant": "emphasis", "route": "vertical-channel" }
