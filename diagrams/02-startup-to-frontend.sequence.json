{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Startup Path: Session File to First Widget Render",
    "subtitle": "One-shot collection, durable commit, then command/event recovery",
    "output": "02-startup-to-frontend.html",
    "animation": "none",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1080, 695],
    "views": [
      {
        "id": "scan-and-read",
        "label": "Scan and read",
        "focus": ["runtime", "files", "parser"],
        "note": "Discovery captures metadata; the adapter reads from the persisted byte offset."
      },
      {
        "id": "commit-and-query",
        "label": "Commit and query",
        "focus": ["runtime", "store"],
        "note": "Events, checkpoints, source health, and diagnostics share one SQLite transaction."
      },
      {
        "id": "wire-recovery",
        "label": "Wire and recovery",
        "focus": ["runtime", "ui"],
        "note": "The initial command recovers the state even if the startup event raced the webview."
      }
    ]
  },
  "participants": [
    { "id": "files", "type": "external", "label": "Session files", "sublabel": "JSONL" },
    { "id": "runtime", "type": "backend", "label": "Rust runtime", "sublabel": "AppState" },
    { "id": "parser", "type": "backend", "label": "Provider adapter", "sublabel": "Claude/Codex" },
    { "id": "store", "type": "database", "label": "SQLite index", "sublabel": "normalized" },
    { "id": "ui", "type": "frontend", "label": "Widget webview", "sublabel": "summary hook" }
  ],
  "segments": [
    { "from": 152, "to": 316, "label": "Bootstrap + discovery" },
    { "from": 344, "to": 480, "label": "Commit + summary" },
    { "from": 508, "to": 624, "label": "Event + command recovery" }
  ],
  "messages": [
    { "id": "resolve-roots", "from": "runtime", "to": "files", "y": 180, "label": "resolve safe provider roots", "variant": "emphasis", "note": "USERPROFILE + configured override" },
    { "id": "return-candidates", "from": "files", "to": "runtime", "y": 220, "label": "ordered paths + size/mtime", "variant": "return", "note": "path stays Rust-private" },
    { "id": "read-at-offset", "from": "runtime", "to": "parser", "y": 260, "label": "read from checkpoint offset", "variant": "emphasis", "note": "seek + bounded line" },
    { "id": "return-observations", "from": "parser", "to": "runtime", "y": 300, "label": "observations + next/pending offset", "variant": "return", "note": "unknown kinds ignored" },
    { "id": "begin-batch", "from": "runtime", "to": "store", "y": 348, "label": "BEGIN events + checkpoints", "variant": "emphasis", "note": "health + diagnostics included" },
    { "id": "commit-result", "from": "store", "to": "runtime", "y": 388, "label": "COMMIT or rollback", "variant": "return" },
    { "id": "query-history", "from": "runtime", "to": "store", "y": 428, "label": "query events through now", "variant": "default", "note": "current implementation passes day_start = empty" },
    { "id": "return-history", "from": "store", "to": "runtime", "y": 468, "label": "normalized history rows", "variant": "return" },
    { "id": "startup-event", "from": "runtime", "to": "ui", "y": 520, "label": "usage-summary-changed", "variant": "emphasis", "note": "may race page listener" },
    { "id": "initial-command", "from": "ui", "to": "runtime", "y": 560, "label": "listen, then get_usage_summary", "variant": "default" },
    { "id": "initial-summary", "from": "runtime", "to": "ui", "y": 600, "label": "return last committed summary", "variant": "return", "note": "loading → active/idle/unavailable" }
  ],
  "activations": [
    { "participant": "runtime", "from": 176, "to": 480, "type": "backend" },
    { "participant": "parser", "from": 256, "to": 308, "type": "backend" },
    { "participant": "store", "from": 344, "to": 476, "type": "database" },
    { "participant": "ui", "from": 516, "to": 608, "type": "frontend" }
  ]
}
